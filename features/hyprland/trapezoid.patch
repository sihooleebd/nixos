+    // cards, so a hidden pile (parked past the monitor's right edge) can be slid back in and a shown
+    // one slid out. m_wasShown = is any card currently on-screen (x < its monitor's right edge), used
+    // by dock.sh to spring a too-short swipe back to the correct pre-swipe state. (Single monitor on
+    // this host, but checking each card's own monitor keeps it correct on more.)
+    for (auto const& w : Desktop::windowState()->windows()) {
+        if (!w || !w->m_isMapped || !w->m_isFloating || !dpTagged(w, "dock") || dpTagged(w, "pip"))
+            continue;
+        m_cards.emplace_back(w);
+        const auto M   = w->m_monitor.lock();
+        const auto POS = w->position(Desktop::View::IGeometric::GEOMETRIC_GOAL);
+        if (M && POS.x < M->m_position.x + M->m_size.x)
+            m_wasShown = true;
+    }
+}
+
+void CDockPileTrackpadGesture::update(const ITrackpadGesture::STrackpadGestureUpdate& e) {
+    const auto DELTA = e.swipe ? e.swipe->delta : e.pinch->delta;
+    m_lastDelta += DELTA;
+    // slide every pile card horizontally, live under the fingers (same mechanism as the move gesture's
+    // dock path: shift the layout target then warp the animation so it tracks 1:1 with no lag).
+    for (auto const& ref : m_cards) {
+        const auto W = ref.lock();
+        if (!W)
+            continue;
+        g_layoutManager->moveTarget(Vector2D{DELTA.x, 0.F}, W->layoutTarget());
+        W->finishAnimation();
+    }
+}
+
+void CDockPileTrackpadGesture::end(const ITrackpadGesture::STrackpadGestureEnd& e) {
+    // Release: `<gestures:dock_pile_exec> <l|r|none> <1|0 was-shown>` -> dock.sh gesture-pile. A clearly
+    // horizontal swipe of 60px+ settles (l = reveal, finger moved left; r = hide, finger moved right);
+    // anything shorter springs back to the pre-swipe state (none + the was-shown flag). dock.sh animates
+    // the pile from wherever the fingers left it.
+    static auto       PDOCKEXEC = CConfigValue<Config::STRING>("gestures:dock_pile_exec");
+    const std::string CMD       = *PDOCKEXEC;
+    const bool        WAS       = m_wasShown;
+    m_cards.clear();
+    if (CMD.empty() || CMD == STRVAL_EMPTY)
+        return;
+    const char* dir = (std::abs(m_lastDelta.x) >= 60.F && std::abs(m_lastDelta.x) > std::abs(m_lastDelta.y)) ? (m_lastDelta.x < 0 ? "l" : "r") : "none";
+    Config::Supplementary::executor()->spawnRaw(std::format("{} {} {}", CMD, dir, WAS ? "1" : "0"));
+}
